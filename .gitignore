# No trailing slash: a trailing slash matches only a DIRECTORY, so a symlink
# named node_modules (how agent worktrees share the installed tree) was not
# ignored and `git add -A` staged it. Bare `node_modules` matches both.
node_modules

__pycache__/
*.pyc
*.bak

test-results/
.playwright-ledger-data.json

.DS_Store

.claude/settings.local.json
.claude/worktrees/

# Live API credentials. These were previously ignored ONLY via .git/info/exclude,
# which is per-clone and does not travel — a fresh clone, or any tooling that
# recreates the repo, would have seen them as untracked-and-addable. Neither has
# ever been committed (verified), and this keeps it that way everywhere.
.claude/.jira-token
.claude/.sentry-token

# GV-471 simulator run artefacts (journal + violations) — regenerated on every run.
tools/simulator/out/
