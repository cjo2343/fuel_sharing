        "message": "<Tag> color must be one of 'default' | 'amber' | 'leaf' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|variant|visible|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, variant, visible, onDismiss."
