        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|success|money|error|info)$/]",
        "message": "<Toast> variant must be one of 'default' | 'success' | 'money' | 'error' | 'info'."
