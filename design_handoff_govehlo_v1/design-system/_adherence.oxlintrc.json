        "selector": "JSXOpeningElement[name.name='TripCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|startOdo|endOdo|driver|cost|onClick|key|ref|className|style|children)$/]",
        "message": "<TripCard> doesn't accept that prop. Declared props: date, startOdo, endOdo, driver, cost, onClick."
      }
