# Local server
# Render sets PORT automatically. Leave unset for normal local development.
PORT=4175

# Optional local data file override.
FUEL_LEDGER_DATA_FILE=ledger-data.local.json

# Local API auth.
# Set this to 1 only for local/Playwright runs that intentionally exercise the
# JSON fallback API without FUEL_LEDGER_API_SECRET.
FUEL_LEDGER_ALLOW_UNAUTHENTICATED_LOCAL_API=1
FUEL_LEDGER_REQUIRE_API_AUTH=0
FUEL_LEDGER_API_SECRET=

# Supabase server-side/script settings.
# Do not put real secrets in this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REMINDER_LEDGER_ID=main-car

# Reminder jobs.
REMINDER_DATA_SOURCE=local_json
REMINDER_CRON_SECRET=

# Push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional vehicle/number-plate lookup.
# Keep real provider API keys in Render environment variables only.
VEHICLE_LOOKUP_API_URL=https://nummerplade-tjek.dk/api/v1/vehicles/{plate}
VEHICLE_LOOKUP_API_KEY=
VEHICLE_LOOKUP_API_KEY_HEADER=X-API-Key
VEHICLE_LOOKUP_API_KEY_PREFIX=
VEHICLE_LOOKUP_PLATE_PARAM=plate
VEHICLE_LOOKUP_SOURCE_LABEL=Nummerplade Tjek
